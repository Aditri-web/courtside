# CourtSide AI Service - Environment Configuration
# Copy this file to .env and fill in your values

PORT=4000
NODE_ENV=development

# -----------------------------------------
# LLM Provider: "mock" (default) or "gemini"
# -----------------------------------------
# Set LLM_PROVIDER=gemini and add GEMINI_API_KEY to enable real AI.
# Without a key the service runs in fully offline mode with curated
# deterministic responses that are still hackathon-demo quality.
LLM_PROVIDER=mock

# Google Gemini 1.5 Flash API key
# Get yours free at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Response cache TTL (milliseconds). Default 5 minutes.
CACHE_TTL_MS=300000
