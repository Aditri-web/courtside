{
  "installCommand": "corepack enable && corepack yarn install",
  "buildCommand": "corepack yarn build:web",
  "outputDirectory": "apps/expo-multi-tv/dist",
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/demo.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
